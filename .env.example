# OpenMontage - Environment Variables
# Copy this to .env and fill in your keys

# --- QA Supervisor Cryptographic Verification (CRITICAL) ---
# Shared HMAC secret key used by Independent QA Supervisor to sign approval.json records.
# Verified by scheduler and publisher containers before releasing or natively scheduling videos.
# Must be identical across docker containers (worker and scheduler) to prevent signature mismatches.
QA_SUPERVISOR_SECRET=
# Enforce strict QA gates in production (1 = enabled, 0 = disabled)
STRICT_QA=1
PRODUCTION_RELEASE=1

# --- Automated Daily News Pipeline & Evidence Gate ---
# Muse discovery uses the dedicated chat endpoint on this gateway origin.
# The thread cache must be persisted and shared across scheduler restarts.
NEWS_DISCOVERY_PROVIDER=muse
MUSE_GATEWAY_URL=http://127.0.0.1:20129
MUSE_THREAD_CACHE=data/muse_thread_cache.json
# Set NEWS_DISCOVERY_PROVIDER=daily-news to explicitly use the legacy feed.
# NewsNow feed endpoint (running locally in Docker or host port 4444)
# --- Toolcase Gateway Daily News Service ---
# Gateway endpoint for latest news and content discovery (default port 20129)
DAILY_NEWS_GATEWAY_URL=http://127.0.0.1:20129/custom/daily-news
# Legacy alias:
NEWSNOW_API_URL=http://127.0.0.1:20129/custom/daily-news
# Maximum source age in hours allowed by the news evidence gate (e.g. 168 for 7 days, 72 for 3 days)
NEWS_MAX_SOURCE_AGE_HOURS=168
# Target number of validated video projects to generate per daily run (default: 3)
EXPECTED_SUCCESS_COUNT=3
# Number of candidate topics to produce during topic extraction (default: 8)
NEWS_PRODUCE_COUNT=8
# Number of generation retry attempts before logging pipeline error (default: 3)
DAILY_GENERATION_RETRIES=3
# Enable context-aware visual enrichment pipeline (1 = enabled, 0 = disabled)
NEWS_VISUAL_MODE=1
# Optional: set to 1 to bypass FixedNicheScopeGate during testing
# SKIP_SCOPE_GATE=0

# --- Codex CLI & AI Director Configuration ---
# Codex pipeline profile directory (default /root/.codex_pipeline)
CODEX_HOME=/root/.codex_pipeline
# Gateway model catalog ID for Codex agent execution (e.g. model-medium-hight)
CODEX_MODEL=model-medium-hight
# Codex pipeline profile alias (default: omniroute)
CODEX_PIPELINE_PROFILE=omniroute

# --- Image + video gateway ---
# FLUX images, Google Veo video, Kling video, MiniMax video, Recraft images.
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=
# Alias for FAL_KEY (some SDKs/docs use this name); either one is read.
FAL_AI_API_KEY=

# --- Replicate ---
# Replicate-hosted video gen (seedance_replicate). Needed to make the
# Replicate-backed Seedance path selectable alongside the fal.ai one.
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Higgsfield ---
# Higgsfield Cloud key (higgsfield_video). Pair with the secret below,
# or use the combined HIGGSFIELD_KEY="<key>:<secret>" form instead.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# HIGGSFIELD_KEY=            # Combined key:secret — set this INSTEAD of the _KEY/_SECRET pair if you prefer.

# --- Kling official direct API ---
# Official Kling API key; enables video, image, TTS, avatar, lip sync.
KLING_API_KEY=
# Optional endpoint override; leave blank for default https://api-singapore.klingai.com
# Mainland China accounts can use https://api-beijing.klingai.com
KLING_API_BASE_URL=

# --- Google (one key unlocks image gen + TTS + video) ---
# Google Imagen images, Google Cloud TTS (700+ voices, 50+ languages),
# Gemini Omni video (generation + conversational editing, paid tier).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_API_KEY=            # Alias for GOOGLE_API_KEY (takes precedence when both are set)
# Alternative to the API key: service-account JSON auth.
# TTS uses Cloud Text-to-Speech; Imagen routes to Vertex AI.
# Path to a service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=
# GCP project id (required for Imagen via Vertex AI).
GOOGLE_CLOUD_PROJECT=
# Vertex AI region, default us-central1.
GOOGLE_CLOUD_LOCATION=

# --- Voice ---
# TTS narration, music generation, sound effects.
ELEVENLABS_API_KEY=
# OpenAI TTS fallback and GPT Image 2 image generation.
OPENAI_API_KEY=
# Grok image generation/editing and Grok video generation.
XAI_API_KEY=
# Volcengine Doubao Speech TTS (new console API Key).
DOUBAO_SPEECH_API_KEY=
# Default Doubao speaker/voice type, e.g. zh_female_vv_uranus_bigtts.
DOUBAO_SPEECH_VOICE_TYPE=
# Piper local voices do not require env vars; install `piper-tts` via pip

# --- DashScope (Alibaba Cloud Bailian) ---
# Qwen image gen (qwen-image-2.0-pro), TTS (qwen3-tts-flash), ASR with word timestamps (qwen3-asr-flash-filetrans).
# Get one at https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=

# --- Music ---
# Suno AI music generation (full songs, instrumentals, any genre).
SUNO_API_KEY=

# --- Video Generation ---
# HeyGen API (VEO, Sora, Runway, Kling, Seedance via single key).
HEYGEN_API_KEY=
# Runway Gen-4 (direct API, alternative to fal.ai routing).
RUNWAY_API_KEY=
# Volcengine Jimeng (即梦 AI) video generation via official API (HMAC-SHA256 V4 signing).
VOLC_ACCESSKEY=
# Secret Access Key paired with VOLC_ACCESSKEY. Get both at https://console.volcengine.com/iam/keymanage
VOLC_SECRETKEY=
# Set to "true" for local video gen (needs GPU + diffusers).
VIDEO_GEN_LOCAL_ENABLED=
# Local model: wan2.1-1.3b, wan2.1-14b, hunyuan-1.5, ltx2-local, cogvideo-5b.
VIDEO_GEN_LOCAL_MODEL=
# Modal self-hosted LTX-2 endpoint (optional).
MODAL_LTX2_ENDPOINT_URL=

# --- ComfyUI (optional local/remote workflow rendering) ---
# COMFYUI_SERVER_URL=http://127.0.0.1:8188

# --- Stock Media ---
# Pexels stock footage/images (free).
PEXELS_API_KEY=
# Pixabay stock footage/images (free).
PIXABAY_API_KEY=
# Unsplash stock images (free developer key).
UNSPLASH_ACCESS_KEY=

# --- Analysis ---
# HuggingFace token — enables speaker diarization in transcriber.
HF_TOKEN=
# Speech-to-text: optional Azure AI Speech (Fast Transcription). When set, the
# agent prefers azure_stt for cloud STT; the local faster-whisper transcriber
# remains the default offline path.
# Azure AI Speech resource key ('Keys and Endpoint' page).
AZURE_SPEECH_KEY=
# Speech resource region, e.g. eastus.
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=     # Optional: full custom endpoint URL (overrides region)

# --- Avatar (local installs) ---
# WAV2LIP_PATH=              # Path to cloned Wav2Lip repo (for lip sync)
# SADTALKER_PATH=            # Path to cloned SadTalker repo (for talking head avatars)

# --- Publishing (YouTube + Meta + TikTok + Platform Governance) ---
# YouTube Data API v3 OAuth client secret JSON (Desktop app credentials).
YOUTUBE_CLIENT_SECRET_FILE=
# Optional: where the OAuth token is cached. Default ~/.openmontage/youtube_token.json
# YOUTUBE_TOKEN_STORAGE_PATH=
# YouTube channel verification guard: ensures videos are uploaded ONLY to the expected channel ID.
EXPECTED_CHANNEL_ID=
YOUTUBE_EXPECTED_CHANNEL_ID=
# YouTube account label used in the Firestore publish state (default: primary).
# YOUTUBE_ACCOUNT=primary

# Platform publishing mode: 0 = Single-platform (YouTube only, default), 1 = Multi-platform
MULTI_PLATFORM=0
# Platforms enabled for publishing (comma-separated, e.g. "youtube,tiktok" or "youtube,tiktok,instagram").
# Overrides or complements config/publish_platforms.json.
ENABLED_PLATFORMS=youtube,tiktok
# Platforms held (paused) from publishing (comma-separated, e.g. "facebook,instagram").
HOLD_PLATFORMS=facebook
# Meta Graph API user access token (Page + IG publishing permissions).
TOKEN_FACEBOOK=
# Facebook Page ID and linked Instagram Business Account ID.
# These override config/publish_schedule.json when set.
FB_PAGE_ID=
IG_ACCOUNT_ID=

# Publishing timezone (default from config/publish_schedule.json = Asia/Ho_Chi_Minh).
PUBLISH_TZ=Asia/Ho_Chi_Minh
# Default project locale (e.g. en-US for US audience, vi-VN for Vietnamese).
OPENMONTAGE_LOCALE=en-US
# Optional: python interpreter used by cron runner scripts (default /usr/bin/python3).
# OPENMONTAGE_PYTHON=/usr/bin/python3

# --- Toolcase Gateway & TikTok Creator Studio ---
# Toolcase Gateway base URL (default listener port 20129)
TOOLCASE_GATEWAY_URL=http://127.0.0.1:20129
# TikTok Creator Studio Adapter endpoint via Toolcase Gateway
TIKTOK_GATEWAY_BASE_URL=http://127.0.0.1:20129/tiktok
TIKTOK_API_BASE_URL=http://127.0.0.1:20129/tiktok
# TikTok publishing visibility: "only-me" (private, default), "public", "friends"
TIKTOK_DEFAULT_VISIBILITY=only-me
# Enable/disable TikTok publishing in multi-platform runs (1 = enabled, 0 = disabled)
TIKTOK_PUBLISH_ENABLED=1
# Optional: path to cookies JSON file or custom storage state
# TIKTOK_COOKIE_FILE=~/.openmontage/tiktok_cookies.json
# Direct TikTok API credentials (when not routing via Toolcase Gateway):
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# --- Toolcase Gateway & Meta Business Suite / Facebook Adapter ---
# Facebook Suite Adapter endpoint via Toolcase Gateway (port 20129)
FACEBOOK_GATEWAY_BASE_URL=http://127.0.0.1:20129/custom/facebook
# Enable/disable Facebook publishing in multi-platform runs (1 = enabled, 0 = disabled)
FACEBOOK_PUBLISH_ENABLED=1
# Optional: Facebook Page ID override
# FB_PAGE_ID=

# --- Muse AI Gateway ---
# Points to Toolcase Gateway at port 20129
MUSE_GATEWAY_BASE_URL=http://127.0.0.1:20129

# --- Firebase (publish dedup / state store) ---
# Service-account JSON (inline JSON string or path to file) with Firestore access.
FIREBASE_SERVICE_ACCOUNT=

# --- Cloudflare R2 (temp hosting for Instagram Reels upload) ---
CLOUDFLARE_R2_KEY_ID=
CLOUDFLARE_R2_SECRET=
# CLOUDFLARE_R2_SERECT=      # Supported fallback for common typo
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET_NAME=

# --- W&B AgentLens Tracing (optional) ---
# Enable AgentLens tracing of pipeline runs with EITHER:
#   - a local W&B login (credentials in ~/.netrc via `wandb login`), or
#   - WANDB_API_KEY below.
# Project routing (entity/project) can be overridden via WANDB_AGENTLENS_PROJECT.
WANDB_API_KEY=
WANDB_AGENTLENS_PROJECT=playgamelade6-abc/project-server-140
