# OpenMontage daily automated pipeline & publisher crontab
#
# Times are in UTC. Vietnam local slots run next day at 09:15/14:15/21:15 ICT.
# Pipeline runs 06:00 VN (23:00 UTC previous day). Slots fire 02:15/07:15/14:15 UTC.
#
# DEFAULT: Single-platform publishing (YouTube only) to prevent duplicates.
# Multi-platform mode can be enabled by setting MULTI_PLATFORM=1.
#
# All commands use absolute paths and append logs so cron has same runtime as manual runs.
# Instagram slots: Instagram lacks native scheduling, so cron triggers Instagram publishing
# at specific Vietnam time slots. YouTube uses platform-native scheduling; Facebook is disabled.

PATH=/usr/local/bin:/usr/bin:/bin
PATH_TO_OPENMONTAGE=/app
CODEX_HOME=/root/.codex_pipeline

# Key rotation procedure:
# When updating OPENAI_API_KEY or other credentials:
# 1. Update source files in /etc/codex_source (or CODEX_SOURCE_DIR).
# 2. Run init_codex_profile.sh with REFRESH_CODEX_PROFILE=1 to force profile replacement.
# 3. Restart scheduler and worker containers with: docker compose restart scheduler worker
#    (Note: `docker compose up -d` will NOT restart containers if the compose definition is unchanged;
#    mounted file updates require explicit restart to be picked up by running containers).

# 23:00 UTC (06:00 Vietnam next day) — Strict orchestrator: publish today's slots,
# generate next-day videos, validate, queue them for tomorrow's slot cron.
0 23 * * * cd /app && OPENMONTAGE_PYTHON=/usr/bin/python3 MULTI_PLATFORM=0 ./scripts/run_strict_docker_publish.sh >> logs/cron_pipeline.log 2>&1

# 02:15 UTC (09:15 Vietnam) — Publish slot 1 (Instagram only)
15 2 * * * cd /app && export PYTHONPATH=/app && export INSTAGRAM_MODE=1 && OPENMONTAGE_PYTHON=/usr/bin/python3 /usr/bin/python3 scripts/publish_active_projects.py --slot 09:15 --only-platform instagram >> logs/cron_publish.log 2>&1

# 07:15 UTC (14:15 Vietnam) — Publish slot 2 (Instagram only)
15 7 * * * cd /app && export PYTHONPATH=/app && export INSTAGRAM_MODE=1 && OPENMONTAGE_PYTHON=/usr/bin/python3 /usr/bin/python3 scripts/publish_active_projects.py --slot 14:15 --only-platform instagram >> logs/cron_publish.log 2>&1

# 14:15 UTC (21:15 Vietnam) — Publish slot 3 (Instagram only)
15 14 * * * cd /app && export PYTHONPATH=/app && export INSTAGRAM_MODE=1 && OPENMONTAGE_PYTHON=/usr/bin/python3 /usr/bin/python3 scripts/publish_active_projects.py --slot 21:15 --only-platform instagram >> logs/cron_publish.log 2>&1

# Hourly, independent of generation success. Canonical verified-publication guards
# remain mandatory; no age-based deletion and no publishing. flock prevents overlap.
35 * * * * cd /app && PYTHONPATH=/app /usr/bin/flock -n /app/logs/published_cleanup.lock /usr/bin/python3 -m scripts.cleanup_published_projects --apply >> logs/cron_cleanup.log 2>&1

# Folder structure:
# - projects/ - New generated projects (daily pipeline)
# - projects/instagram/ - Projects moved here after YouTube/FB scheduling (Instagram cron processing)
# - Instagram cron jobs look in projects/instagram/ and delete projects after successful Instagram publish
# - YouTube uses platform-native scheduling and doesn't need cron; Facebook is disabled.
