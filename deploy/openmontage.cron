# OpenMontage daily automated pipeline & publisher crontab
#
# Times are in UTC (00:00 UTC = 07:00 WIB / Jakarta time).

PATH_TO_OPENMONTAGE=/app

# 00:00 UTC (07:00 WIB) — Auto-select trending topic, generate Vietnamese video & publish metadata
0 0 * * * cd /app && ./scripts/run_daily_news_pipeline.sh >> logs/cron_pipeline.log 2>&1

# 01:00 UTC (08:00 WIB) — Auto-publish all active projects to YouTube, Instagram & Facebook
0 1 * * * cd /app && PYTHONPATH=/app python3 scripts/publish_active_projects.py >> logs/cron_publish.log 2>&1

# Fully published projects are removed from projects/ and deactivated from the
# schedule by publish_active_projects.py. Failed or partial batches remain for retry.
