{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/multishot/character_bible",
  "title": "Character Bible",
  "description": "Immutable character identity locked across all shots — roles, body/face/clothing specs, personality, motion style, and forbidden changes.",
  "type": "object",
  "required": ["version", "characters"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "locked_identity"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^char_[a-zA-Z0-9_]+$"
          },
          "name": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": ["main", "supporting", "background"],
            "default": "supporting"
          },
          "locked_identity": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "body": { "type": "string" },
              "face": { "type": "string" },
              "eyes": { "type": "string" },
              "fur": { "type": "string" },
              "markings": { "type": "string" },
              "clothing": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          },
          "personality": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "motion_style": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "forbidden_changes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}