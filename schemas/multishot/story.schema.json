{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/multishot/story",
  "title": "Story Bible",
  "description": "Project narrative — title, summary, ordered beats with mandatory beginning/hook, escalation, climax, resolution/punchline coverage.",
  "type": "object",
  "required": ["version", "title", "topic", "beats"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "description": "One-paragraph high-level story summary carried into prompts."
    },
    "beats": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "type", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^beat_\\d{2}$"
          },
          "type": {
            "type": "string",
            "enum": ["hook", "escalation", "climax", "resolution", "punchline"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "locations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "important_props": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}