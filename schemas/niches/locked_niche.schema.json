{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator Locked Niche",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "niche_id": {
      "type": "string",
      "const": "us-ai-agent-engineering"
    },
    "status": {
      "type": "string",
      "const": "LOCKED_BY_OWNER"
    },
    "owner_change_required": {
      "type": "boolean",
      "const": true
    },
    "allow_agent_niche_discovery": {
      "type": "boolean",
      "const": false
    },
    "allow_agent_niche_switch": {
      "type": "boolean",
      "const": false
    },
    "allow_agent_edit_policy": {
      "type": "boolean",
      "const": false
    },
    "market": {
      "type": "string",
      "const": "US"
    },
    "locale": {
      "type": "string",
      "const": "en-US"
    },
    "channel_positioning": {
      "type": "object",
      "required": [
        "name",
        "promise",
        "primary_viewer",
        "viewer_level",
        "content_boundary"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "promise": {
          "type": "string",
          "minLength": 2
        },
        "primary_viewer": {
          "type": "string",
          "minLength": 2
        },
        "viewer_level": {
          "type": "string",
          "minLength": 2
        },
        "content_boundary": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "allowed_topic_families": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "allowed_formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "blocked_topics": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "content_rules": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "string"
        ]
      },
      "required": [
        "topic_must_match_fixed_niche",
        "fallback_to_another_niche",
        "insufficient_topic_action"
      ],
      "properties": {
        "topic_must_match_fixed_niche": {
          "const": true
        },
        "fallback_to_another_niche": {
          "const": false
        },
        "insufficient_topic_action": {
          "const": "NO_ELIGIBLE_TOPIC"
        }
      }
    },
    "source_policy": {
      "type": "object",
      "properties": {
        "discovery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "community_signal_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "require_canonical_url": {
          "const": true
        },
        "require_published_date_for_news": {
          "const": true
        },
        "forbid_made_up_release_dates": {
          "const": true
        }
      },
      "additionalProperties": false,
      "required": [
        "discovery",
        "primary_evidence",
        "community_signal_only",
        "require_canonical_url",
        "require_published_date_for_news",
        "forbid_made_up_release_dates"
      ]
    },
    "video_contract": {
      "type": "object",
      "properties": {
        "shorts": {
          "type": "object"
        },
        "longform": {
          "type": "object"
        },
        "visuals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "voice_locale": {
          "const": "en-US"
        },
        "captions_from_final_audio": {
          "const": true
        },
        "preserve_voice_consistency": {
          "const": true
        }
      },
      "required": [
        "shorts",
        "longform",
        "visuals",
        "voice_locale",
        "captions_from_final_audio",
        "preserve_voice_consistency"
      ],
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "properties": {
        "generate_video_only": {
          "const": true
        },
        "auto_publish": {
          "const": false
        },
        "private_canary_only_after_approval": {
          "const": true
        },
        "max_parallel_render": {
          "const": 1
        },
        "max_parallel_asr": {
          "const": 1
        },
        "avoid_local_tts_during_render": {
          "const": true
        },
        "never_force_daily_quota": {
          "const": true
        },
        "operator_config_hash_required": {
          "const": true
        },
        "no_runtime_policy_mutation": {
          "const": true
        }
      },
      "required": [
        "generate_video_only",
        "auto_publish",
        "private_canary_only_after_approval",
        "max_parallel_render",
        "max_parallel_asr",
        "never_force_daily_quota",
        "operator_config_hash_required",
        "no_runtime_policy_mutation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "niche_id",
    "status",
    "owner_change_required",
    "allow_agent_niche_discovery",
    "allow_agent_niche_switch",
    "allow_agent_edit_policy",
    "market",
    "locale",
    "channel_positioning",
    "allowed_topic_families",
    "allowed_formats",
    "blocked_topics",
    "content_rules",
    "source_policy",
    "video_contract",
    "production"
  ],
  "additionalProperties": false
}
