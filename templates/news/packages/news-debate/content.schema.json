{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/news_templates/news-debate/content",
  "title": "news-debate content instance (v1.0.0)",
  "description": "Attributed statements, AI-risk debate, context and uncertainty. Required slots: hook, statement (with attribution). Optional: context, takeaway. No invented counterargument; a contrasting side is shown only when grounded.",
  "type": "object",
  "required": ["template", "template_version", "variant", "title", "duration", "narration", "slots"],
  "properties": {
    "template": { "const": "news-debate" },
    "template_version": { "const": "1.0.0" },
    "variant": { "type": "string", "enum": ["full", "short"] },
    "kicker": { "type": "string" },
    "title": { "type": "string", "minLength": 3 },
    "duration": { "type": "number", "minimum": 8 },
    "narration": { "type": "string", "minLength": 1 },
    "narration_short": { "type": "string", "minLength": 1 },
    "caption_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "start", "end"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "slots": {
      "type": "object",
      "required": ["hook", "statement"],
      "properties": {
        "hook": { "$ref": "#/$defs/slot" },
        "statement": {
          "allOf": [{ "$ref": "#/$defs/slot" }],
          "required": ["attribution"],
          "description": "The attributed statement/quote. Attribution required: who said it. Proper names allowed."
        },
        "context": { "$ref": "#/$defs/slot" },
        "takeaway": { "$ref": "#/$defs/slot" }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "array",
      "description": "Optional locally-staged media bindings. src must be a relative assets/ path ending in .mp4, .webm, or .mp3. No remote URLs.",
      "items": {
        "type": "object",
        "required": ["src", "start", "end"],
        "properties": {
          "src": { "type": "string", "pattern": "^assets/[^/]+\\.(mp4|webm|mp3)$" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "volume": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "theme": { "type": "object", "properties": { "accent": { "type": "string" } }, "additionalProperties": false }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "variant": { "const": "short" } }, "required": ["variant"] },
      "then": { "required": ["narration_short"], "properties": { "duration": { "maximum": 58 } } }
    }
  ],
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["heading", "text", "start", "end"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string" },
        "source_url": { "type": "string" },
        "label": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
